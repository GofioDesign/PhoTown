# Local development only. Copy to .dev.vars; replace both values.
INVITE_CODE=replace-with-a-long-private-invitation-code
SESSION_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_EMAILS=admin@example.com
# Browser tests only: lets localhost return sign-in links without sending email.
DEV_LOGIN_LINKS=true
# Production only (wrangler secret put RESEND_API_KEY). Leave unset locally.
# RESEND_API_KEY=
