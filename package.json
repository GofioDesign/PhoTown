{
  "name": "photown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "for f in server/*.js public/*.js; do node --check $f || exit 1; done",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
