{
  "name": "photown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node --check server/worker.js && node --check public/app.js && node --check public/processing.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "@playwright/test": "^1.58.0", "wrangler": "^4.0.0" }
}
